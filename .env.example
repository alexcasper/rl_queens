# Queens Game RL Training Environment Variables
# Copy this file to .env and fill in your values

# TrackIO Configuration (Optional)
TRACKIO_API_KEY=your_trackio_api_key_here
TRACKIO_PROJECT=queens-rl-training

# HuggingFace Hub Configuration (Optional)
HF_TOKEN=your_huggingface_token_here
HF_HUB_ENABLE_HF_TRANSFER=1

# Training Configuration
LOG_LEVEL=INFO

# GPU Configuration (for MI300X)
HIP_VISIBLE_DEVICES=0
HSA_OVERRIDE_GFX_VERSION=11.0.0

# Model Configuration
MODEL_NAME=unsloth/gpt-oss-20b
OUTPUT_DIR=outputs_queens
MAX_STEPS=600
BATCH_SIZE=1

# Environment Configuration
SERVER_PORT=8003
HEALTH_CHECK_INTERVAL=30
